#include <iostream>
using namespace std;

int main() {
    int price;
    int total = 0;
    
    cout << "Enter a number (0 to stop): ";
    cin >> price;
    
    while (price != 0) {
        total += price;
        
        cout << "Enter a number (0 to stop): ";
        cin >> price;
    }
    
    cout << "\nTotal: " << total << "\n";
    
    return 0;
}
